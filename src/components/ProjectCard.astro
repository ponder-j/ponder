---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  demo?: string;
  repo?: string;
}

const { title, description, tags = [], demo, repo } = Astro.props;
---

<article class="card">
  <h3>{title}</h3>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )
  }
  {
    (demo || repo) && (
      <div class="card-links">
        {demo && <a href={demo} target="_blank" rel="noopener">在线预览 →</a>}
        {repo && <a href={repo} target="_blank" rel="noopener">源码 ↗</a>}
      </div>
    )
  }
</article>

<style>
  .card-links {
    margin-top: 12px;
    display: flex;
    gap: 16px;
    font-size: 0.9rem;
  }
</style>
