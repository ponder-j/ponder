---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  href: string;
}

const { title, description, pubDate, tags = [], href } = Astro.props;
const dateText = pubDate.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card">
  <h3><a href={href}>{title}</a></h3>
  <div class="card-date">{dateText}</div>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )
  }
</article>
